{
  "expo": {
    "name": "Orbit",
    "slug": "orbit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orbit",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090B",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "app.orbit.mobile",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Orbit uses your camera so other participants can see you on video calls.",
        "NSMicrophoneUsageDescription": "Orbit uses your microphone so other participants can hear you on video and audio calls.",
        "UIBackgroundModes": [
          "voip"
        ],
        "RTCAppGroupIdentifier": "group.app.orbit.mobile",
        "RTCScreenSharingExtension": "app.orbit.mobile.broadcast"
      }
    },
    "android": {
      "package": "app.orbit.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#09090B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Orbit uses your photo library to share images in chat."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B5FFF"
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "enableScreenShareService": true
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
