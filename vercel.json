{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npx expo export --platform web --max-workers 2 --clear",
  "outputDirectory": "dist",
  "installCommand": "npm ci --no-audit --no-fund",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
