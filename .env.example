# Copy this file to .env and fill in real values. All client-readable vars
# must be prefixed EXPO_PUBLIC_ (Expo inlines them into the JS bundle).
# The app runs and its UI is fully navigable with none of these set —
# features that need a backend just show an explanatory message instead of
# erroring.
#
# Note: most Firebase config does NOT go here. It lives in
# google-services.json (Android) and GoogleService-Info.plist (iOS) at the
# project root — see README.md for where to get those.

# --- Firebase Auth: magic-link action handler ---
# Must be a domain listed in Firebase Console > Authentication > Settings >
# Authorized domains. Your project's default Firebase Hosting domain works:
# https://<project-id>.firebaseapp.com
EXPO_PUBLIC_FIREBASE_AUTH_CONTINUE_URL=

# --- Google Sign-In ---
# The "Web client" OAuth client ID Firebase creates automatically once you
# enable Google as a sign-in provider (Authentication > Sign-in method >
# Google). Console > Project Settings > General, or in google-services.json
# under client[].oauth_client[] where client_type is 3.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Sentry (crash reporting) — wired in Phase 5 ---
EXPO_PUBLIC_SENTRY_DSN=

# --- PostHog (analytics) — wired in Phase 5 ---
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
