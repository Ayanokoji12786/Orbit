# Copy this file to .env and fill in real values. All client-readable vars
# must be prefixed EXPO_PUBLIC_ (Expo inlines them into the JS bundle).
# The app runs and its UI is fully navigable with none of these set —
# features that need a backend just show an explanatory message instead of
# erroring.

# --- Supabase ---
# Project Settings > API in the Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Sign-In ---
# Unlike Firebase, Supabase doesn't auto-provision this OAuth client. Create
# a "Web application" OAuth client in Google Cloud Console, paste its
# Client ID + Secret into Supabase's Google provider config (Authentication >
# Providers > Google), and the Client ID here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Sentry (crash reporting) — wired in Phase 5 ---
EXPO_PUBLIC_SENTRY_DSN=

# --- PostHog (analytics) — wired in Phase 5 ---
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
