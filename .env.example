# Copy this file to .env and fill in real values. All client-readable vars
# must be prefixed EXPO_PUBLIC_ (Expo inlines them into the JS bundle).
# Nothing here is optional forever, but the app runs and its UI is fully
# navigable with none of these set — features that need a backend just
# show an explanatory message instead of erroring.

# --- Supabase (Auth, Postgres, Storage, Realtime, Edge Functions) ---
# Create a project at https://supabase.com, then Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Sign-In (OAuth client, one ID per platform) ---
# Create at https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- LiveKit (video calling) — wired in Phase 2 ---
# Create a project at https://cloud.livekit.io
EXPO_PUBLIC_LIVEKIT_URL=

# --- Sentry (crash reporting) — wired in Phase 5 ---
EXPO_PUBLIC_SENTRY_DSN=

# --- PostHog (analytics) — wired in Phase 5 ---
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
